{
  "name": "anatomy-atelier",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "deploy": "CLOUDFLARE_DEPLOY=1 npm run build && wrangler deploy",
    "build:next": "next build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "typecheck": "tsc --noEmit --incremental false",
    "test:source": "node --test tests/source-contract.test.mjs tests/dependency-hardening.test.mjs",
    "test:rendered": "node --test tests/rendered-html.test.mjs tests/worker-api.test.mjs",
    "test": "npm run test:source && npm run typecheck && npm run build && npm run test:rendered",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "models:build": "node scripts/build-anatomy-models.mjs",
    "models:refine": "node scripts/refine-atlas.mjs",
    "models:detail:pack": "node scripts/pack-detailed-studies.mjs",
    "db:generate": "drizzle-kit generate",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "gsap": "^3.15.0",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.0",
    "@cloudflare/workers-types": "5.20260813.1",
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "meshoptimizer": "1.1.1",
    "patch-package": "8.0.1",
    "react-server-dom-webpack": "19.2.8",
    "sharp": "0.35.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.1",
    "wrangler": "4.122.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    }
  },
  "type": "module"
}
